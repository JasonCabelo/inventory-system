# Frontend URL (Update this to your production Vercel domain)
FRONTEND_URL=https://your-project.vercel.app

# JWT Configuration - GENERATE A NEW SECRET FOR PRODUCTION!
# Use a strong random string, at least 32 characters
JWT_SECRET=change-this-to-a-strong-random-secret-key-at-least-32-chars

# MongoDB Connection String - Update with your credentials
# Format: mongodb+srv://username:password@cluster.mongodb.net/inventory?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventory

# Environment
NODE_ENV=production
JWT_EXPIRES_IN=30d
