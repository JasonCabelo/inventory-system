{
  "name": "enterprise-inventory-system",
  "version": "1.0.0",
  "private": true,
"workspaces": [
  "server",
  "src"
],
  "scripts": {
    "install:all": "npm install",
"dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=src\"",
  "build": "npm run build --workspace=src",
  "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
