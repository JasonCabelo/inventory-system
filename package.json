{
  "name": "enterprise-inventory-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "src"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=src\" --kill-others",
    "build": "npm run build --workspace=src",
    "start": "npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=src",
    "deploy:vercel": "vercel --prod",
    "deploy:render": "echo 'Push to GitHub and use Render Blueprint or Dashboard'",
    "vercel:link": "vercel link",
    "vercel:env": "vercel env add VITE_API_URL"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
