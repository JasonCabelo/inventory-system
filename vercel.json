{
  "version": 2,
  "buildCommand": "npm run build --workspace=src",
  "outputDirectory": "src/dist",
  "builds": [
    {
      "src": "src/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/dist/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://$VERCEL_URL/api",
    "NODE_ENV": "production"
  }
}
